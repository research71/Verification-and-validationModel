    <org.eventb.core.event name="*X" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="tick_tock">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="tick_tock"/>
        <org.eventb.core.parameter name="'" org.eventb.core.identifier="tm"/>
        <org.eventb.core.guard name="internal1" org.eventb.core.label="grd1" org.eventb.core.predicate="tm ∈ {60}"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="current_time≔ current_time+tm" org.eventb.core.label="act1"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd3" org.eventb.core.predicate="current_time + tm ≤ Horizon"/>
        <org.eventb.core.guard name="*" org.eventb.core.label="grd4" org.eventb.core.predicate="∀ a · a ∈ dom(ETA) ∧ a ∉ dom(legOf) ⇒ current_time + tm &lt; ETA(a) + 60"/>
        <org.eventb.core.guard name="-" org.eventb.core.label="grd7" org.eventb.core.predicate="∀a · a ∈ AIRCRAFTS ∧ sched_time(plan)(a) ≤ current_time ⇒ a ∈ dom(brandof)"/>
        <org.eventb.core.guard name="internal2" org.eventb.core.label="grd8" org.eventb.core.predicate="¬(∃a · a ∈ aircrafts_in_TMA ∧ statusof(a) = Blocked ∧ a ∈ dom(mergeTime) ∧ a ∈ dom(legOf) ∧ a ∉ dom(plannedRunway) ∧ a ∈ dom(cpOf) ∧ a ∈ dom(cpTime) ∧ (∀b · b ∈ dom(cpTime) ∧ b ≠ a ∧ CPRunway(cpOf(b)) = CPRunway(cpOf(a)) ∧ cpTime(b) &lt; cpTime(a) ⇒ b ∈ dom(plannedRunway)))"/>
        <org.eventb.core.guard name="internal3" org.eventb.core.label="grd9" org.eventb.core.predicate="¬(∃a · a ∈ aircrafts_in_TMA ∧ statusof(a) = ScheduledL ∧ a ∈ dom(mergeTime) ∧ current_time ≥ mergeTime(a) ∧ a ∈ dom(plannedRunway) ∧ 1 ∈ dom(landingQueue(plannedRunway(a))) ∧ landingQueue(plannedRunway(a))(1) = a)"/>
        <org.eventb.core.guard name="internal4" org.eventb.core.label="grd10" org.eventb.core.predicate="¬(∃a · a ∈ aircrafts_in_TMA ∧ statusof(a) = ReadyL ∧ a ∉ dom(clearanceL) ∧ a ∈ dom(plannedRunway) ∧ a ∈ dom(cpOf) ∧ a ∈ dom(cpTime) ∧ a ∈ dom(mergeTime) ∧ current_time ≥ cpTime(a) ∧ current_time ≥ mergeTime(a) ∧ 1 ∈ dom(landingQueue(plannedRunway(a))) ∧ landingQueue(plannedRunway(a))(1) = a ∧ (∀b · b ∈ dom(clearanceL) ∧ clearanceL(b) = plannedRunway(a) ∧ b ≠ a ∧ b ∈ dom(Threshold) ∧ b ∈ dom(brandof) ∧ Threshold(b) ≤ current_time + FinalDuration(cpOf(a)) ⇒ current_time + FinalDuration(cpOf(a)) − Threshold(b) ≥ Separation_time(brandof(b) ↦ brandof(a))))"/>
        <org.eventb.core.guard name="internal5" org.eventb.core.label="grd11" org.eventb.core.predicate="¬(∃a · a ∈ aircrafts_in_TMA ∧ statusof(a) = ExecutedL ∧ a ∈ dom(clearanceL) ∧ a ∈ dom(Threshold) ∧ current_time ≥ Threshold(a) ∧ a ∉ dom(TouchdownTime) ∧ curr_RW_status(clearanceL(a)) = Available ∧ curr_RWL_status(clearanceL(a)) = OFF ∧ (clearanceL(a) ∉ dom(lastDepTime) ∨ current_time ≥ lastDepTime(clearanceL(a)) + RwySep) ∧ (clearanceL(a) ∉ dom(lastlandingtime) ∨ current_time ≥ lastlandingtime(clearanceL(a)) + Separation_time(lastlandingBrand(clearanceL(a)) ↦ brandof(a))))"/>
        <org.eventb.core.guard name="internal6" org.eventb.core.label="grd12" org.eventb.core.predicate="∀a · a ∈ aircrafts_in_TMA ∧ statusof(a) = Landing ∧ a ∈ dom(TouchdownTime) ⇒ current_time &lt; TouchdownTime(a) + 60"/>
        <org.eventb.core.guard name="internal7" org.eventb.core.label="grd13" org.eventb.core.predicate="∀a · a ∈ aircrafts_in_TMA ∧ statusof(a) = Takingoff ∧ a ∈ dom(depTime) ⇒ current_time &lt; depTime(a) + 60"/>
        <org.eventb.core.guard name="internal8" org.eventb.core.label="grd14" org.eventb.core.predicate="¬(∃a · a ∈ aircrafts_in_TMA ∧ (statusof(a) = TerminatedL ∨ statusof(a) = TerminatedT ∨ (statusof(a) = ReadyT ∧ a ∉ dom(clearanceT))))"/>
        <org.eventb.core.guard name="internal9" org.eventb.core.label="grd15" org.eventb.core.predicate="¬(∃a · a ∈ aircrafts_in_TMA ∧ statusof(a) = ExecutedT ∧ a ∈ dom(clearanceT) ∧ a ∈ dom(readyTime) ∧ a ∉ dom(depTime) ∧ curr_RW_status(clearanceT(a)) = Available ∧ curr_RWL_status(clearanceT(a)) = OFF ∧ (∀b · b ∈ aircrafts_in_TMA ∧ statusof(b) = ExecutedT ∧ b ∈ dom(readyTime) ∧ b ∈ dom(clearanceT) ∧ clearanceT(b) = clearanceT(a) ⇒ readyTime(b) ≥ readyTime(a)) ∧ (clearanceT(a) ∉ dom(lastDepTime) ∨ current_time ≥ lastDepTime(clearanceT(a)) + DepDepSep(lastDepBrand(clearanceT(a)) ↦ brandof(a))) ∧ (clearanceT(a) ∉ dom(lastlandingtime) ∨ current_time ≥ lastlandingtime(clearanceT(a)) + RwySep))"/>
        <org.eventb.core.guard name="internal:" org.eventb.core.label="grd16" org.eventb.core.predicate="¬(∃a · a ∈ aircrafts_in_TMA ∧ a ∈ dom(legOf) ∧ a ∈ dom(legEntryTime) ∧ a ∈ dom(brandof) ∧ a ∈ dom(legIndex) ∧ a ∉ dom(mergeTime) ∧ a ∈ dom(cpOf) ∧ current_time ≥ legEntryTime(a) ∧ (PmsMerge(legPMS(legOf(a))) ↦ cpOf(a)) ∈ dom(pmCPDist) ∧ (∀b · b ∈ dom(legIndex) ∧ b ∈ dom(legOf) ∧ b ∈ dom(legEntryTime) ∧ legOf(b) = legOf(a) ⇒ legEntryTime(b) ≥ legEntryTime(a)) ∧ (PmsMerge(legPMS(legOf(a))) ∉ dom(lastMergeTime) ∨ current_time + ((wpDistMerge(legSeq(legOf(a))(legIndex(a))) ∗ 360) ÷ legSpeed) ≥ lastMergeTime(PmsMerge(legPMS(legOf(a)))) + Separation_time(lastMergeBrand(PmsMerge(legPMS(legOf(a)))) ↦ brandof(a)) + MergeBuffer) ∧ (∀x · x ∈ dom(mergeTime) ∧ x ∈ dom(legOf) ∧ PmsMerge(legPMS(legOf(x))) = PmsMerge(legPMS(legOf(a))) ⇒ mergeTime(x) &lt; current_time + ((wpDistMerge(legSeq(legOf(a))(legIndex(a))) ∗ 360) ÷ legSpeed) ∧ current_time + ((wpDistMerge(legSeq(legOf(a))(legIndex(a))) ∗ 360) ÷ legSpeed) − mergeTime(x) ≥ Separation_time(brandof(x) ↦ brandof(a))) ∧ (∀b · b ∈ dom(legEntryTime) ∧ b ∈ dom(legOf) ∧ legOf(b) = legOf(a) ∧ legEntryTime(b) &lt; legEntryTime(a) ⇒ b ∈ dom(mergeTime) ∧ mergeTime(b) &lt; current_time + ((wpDistMerge(legSeq(legOf(a))(legIndex(a))) ∗ 360) ÷ legSpeed)) ∧ (cpOf(a) ∉ dom(lastcpTime) ∨ current_time + (((wpDistMerge(legSeq(legOf(a))(legIndex(a))) ∗ 360) ÷ legSpeed) + (pmCPDist(PmsMerge(legPMS(legOf(a))) ↦ cpOf(a)) ∗ 360) ÷ legSpeed) ≥ lastcpTime(cpOf(a)) + Separation_time(lastcpBrand(cpOf(a)) ↦ brandof(a)) + MergeBuffer) ∧ (∀x · x ∈ dom(cpTime) ∧ cpOf(x) = cpOf(a) ⇒ cpTime(x) &lt; current_time + (((wpDistMerge(legSeq(legOf(a))(legIndex(a))) ∗ 360) ÷ legSpeed) + (pmCPDist(PmsMerge(legPMS(legOf(a))) ↦ cpOf(a)) ∗ 360) ÷ legSpeed) ∧ (x ∈ dom(brandof) ⇒ current_time + (((wpDistMerge(legSeq(legOf(a))(legIndex(a))) ∗ 360) ÷ legSpeed) + (pmCPDist(PmsMerge(legPMS(legOf(a))) ↦ cpOf(a)) ∗ 360) ÷ legSpeed) − cpTime(x) ≥ Separation_time(brandof(x) ↦ brandof(a)))))"/>
    </org.eventb.core.event>
